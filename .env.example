# ==============================================================================
# Turso (libSQL) — ฐานข้อมูลหลัก
# ดู URL/Token ได้จาก Turso dashboard หรือรันคำสั่ง `turso db show <db-name> --url`
# และ `turso db tokens create <db-name>`
# ==============================================================================
TURSO_DATABASE_URL=libsql://<your-db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=

# ==============================================================================
# Better Auth
# BETTER_AUTH_SECRET: ใช้เข้ารหัส session/cookie — สุ่มด้วย `openssl rand -base64 32`
#   ห้ามใช้ค่าเดียวกับที่ใช้ตอน dev ให้สุ่มใหม่สำหรับ production
# BETTER_AUTH_URL: ต้องตรงกับ domain จริงที่ deploy (เช่น https://your-app.vercel.app
#   หรือ custom domain) — ใช้ localhost ได้เฉพาะตอนรันบนเครื่อง
# ==============================================================================
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ==============================================================================
# Timezone — ต้องตั้งบน production ด้วย (Vercel รันเป็น UTC ถ้าไม่ตั้ง)
#
# ระบบเก็บเวลาเป็น timestamp แล้วตีความ "เวลาท้องถิ่นของ process" ตอนแปลงกลับ
# ถ้า process เป็น UTC: ห้องที่ประชุมจริง 09:00-10:00 จะขึ้นว่า "ว่าง" ตอนประชุมอยู่
# แล้วไปขึ้น "ไม่ว่าง" ตอน 16:00 แทน (คลาดกัน 7 ชม.) และเส้นเวลาปัจจุบันในปฏิทิน
# จะหายไปทั้งเช้า — ป้ายเวลาจะดูถูกต้อง เพราะเก็บผิดกับอ่านผิดหักล้างกันพอดี
#
# ตอนนี้มีด่านตรวจให้แล้วที่ src/instrumentation.ts: ถ้า production สตาร์ทขึ้นมาแล้ว
# timezone ไม่ใช่ Asia/Bangkok server จะล้มทันทีพร้อมบอกวิธีแก้ ส่วนตอน dev แค่เตือน
# ==============================================================================
TZ=Asia/Bangkok
